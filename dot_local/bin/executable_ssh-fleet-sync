#!/usr/bin/env python3
"""ssh-fleet-sync — build this machine's SSH-mesh config from the r9os fleet registry.

Reads the fleet registry (default: ~/Projects/r9os/references/ssh-fleet.json), determines
which machine THIS is via `scutil --get LocalHostName`, and writes — for every OTHER machine:
  - ~/.ssh/fleet.conf       Host blocks (Include'd from ~/.ssh/config)
  - ~/.ssh/authorized_keys  a managed block of the peers' public keys
  - ~/.ssh/known_hosts      a managed block pinning the peers' host keys

Idempotent — re-run any time (e.g. after `git pull` in r9os adds a machine). Only the
delimited managed block is touched in authorized_keys / known_hosts; other lines are kept.

This script carries NO topology (that lives in the r9os registry), so it is safe in the
public dotfiles repo. Usage: ssh-fleet-sync [--registry PATH] [--dry-run]
"""
import argparse, json, os, subprocess, sys

BEGIN = "# >>> r9os ssh-mesh (managed by ssh-fleet-sync) >>>"
END = "# <<< r9os ssh-mesh <<<"


def local_host_name():
    r = subprocess.run(["scutil", "--get", "LocalHostName"], capture_output=True, text=True)
    return r.stdout.strip()


def upsert_block(path, body):
    """Return new file content with the BEGIN..END block set to `body`, preserving the rest."""
    block = BEGIN + "\n" + body.rstrip("\n") + "\n" + END + "\n"
    existing = ""
    if os.path.exists(path):
        with open(path) as f:
            existing = f.read()
    if BEGIN in existing and END in existing:
        pre = existing.split(BEGIN, 1)[0].rstrip("\n")
        post = existing.split(END, 1)[1].lstrip("\n")
        parts = []
        if pre.strip():
            parts.append(pre + "\n\n")
        parts.append(block)
        if post.strip():
            parts.append("\n" + post)
        return "".join(parts)
    prefix = existing.rstrip("\n") + "\n\n" if existing.strip() else ""
    return prefix + block


def main():
    ap = argparse.ArgumentParser(description="Sync SSH-mesh config from the r9os fleet registry.")
    ap.add_argument("--registry", default=os.path.expanduser("~/Projects/r9os/references/ssh-fleet.json"))
    ap.add_argument("--dry-run", action="store_true", help="print what would be written; change nothing")
    args = ap.parse_args()

    if not os.path.exists(args.registry):
        sys.exit(f"ssh-fleet-sync: registry not found at {args.registry} (is r9os cloned?)")
    with open(args.registry) as f:
        reg = json.load(f)
    default_user = reg.get("user", os.environ.get("USER", ""))
    machines = reg["machines"]

    me = local_host_name()
    if not any(m.get("localHostName") == me for m in machines):
        print(f"ssh-fleet-sync: warning — this machine ({me!r}) is not in the registry, so peers "
              f"cannot reach it yet; add its entry. Generating outbound config anyway.", file=sys.stderr)
    peers = [m for m in machines if m.get("localHostName") != me]
    if not peers:
        sys.exit("ssh-fleet-sync: no peers to configure.")

    conf = ["# Generated by ssh-fleet-sync from the r9os fleet registry. Do NOT edit by hand.",
            f"# Self: {me}.  Peers: {', '.join(m['name'] for m in peers)}.", ""]
    for m in peers:
        names = " ".join([m["name"]] + m.get("aliases", []))
        conf += [f"Host {names}",
                 f"    HostName {m['host']}",
                 f"    User {m.get('user', default_user)}",
                 "    IdentityFile ~/.ssh/id_ed25519",
                 "    IdentitiesOnly yes",
                 ""]
    fleet_conf = "\n".join(conf) + "\n"
    ak_body = "\n".join(m["pubkey"] for m in peers)
    kh_body = "\n".join(f"{m['host']} {m['hostkey']}" for m in peers)

    ssh_dir = os.path.expanduser("~/.ssh")
    fleet_path = os.path.join(ssh_dir, "fleet.conf")
    ak_path = os.path.join(ssh_dir, "authorized_keys")
    kh_path = os.path.join(ssh_dir, "known_hosts")
    new_ak = upsert_block(ak_path, ak_body)
    new_kh = upsert_block(kh_path, kh_body)

    if args.dry_run:
        print("--- ~/.ssh/fleet.conf ---\n" + fleet_conf)
        print("--- authorized_keys managed block ---\n" + BEGIN + "\n" + ak_body + "\n" + END)
        print("\n--- known_hosts managed block ---\n" + BEGIN + "\n" + kh_body + "\n" + END)
        return

    os.makedirs(ssh_dir, exist_ok=True)
    os.chmod(ssh_dir, 0o700)
    for path, content in [(fleet_path, fleet_conf), (ak_path, new_ak), (kh_path, new_kh)]:
        with open(path, "w") as f:
            f.write(content)
        os.chmod(path, 0o600)
    print(f"ssh-fleet-sync: {len(peers)} peer(s) synced — {', '.join(m['name'] for m in peers)}.")
    print("  wrote ~/.ssh/fleet.conf and updated the managed blocks in authorized_keys + known_hosts.")


if __name__ == "__main__":
    main()
