# >>> Claude Code launchers >>>
# cc      = launch Claude Code. Bare `cc` opens the profile picker; skip it
#           with --personal / --work (first arg only; everything else passes
#           through to claude). Non-interactive callers default to personal.
# cc-bhr  = back-compat alias for the work profile; prefer `cc --work`
# r9      = cd to r9os, then cc (same picker / flags). On a machine without
#           a checkout, first run offers to clone it (and, where this machine
#           is granted it, the classified repo) from the home forge.
_cc_personal () {
      claude --permission-mode bypassPermissions "$@"
}

_cc_work () {
      CLAUDE_CONFIG_DIR="$HOME/.claude-bhr" command claude --permission-mode auto "$@"
}

cc () {
      local profile=""
      case "$1" in
            --personal) profile=personal; shift ;;
            --work)     profile=work; shift ;;
      esac

      if [[ -z "$profile" ]]; then
            if [[ -t 0 && -t 1 ]]; then
                  profile=$(_cc_pick) || { print -u2 "cc: cancelled."; return 1 }
            else
                  profile=personal          # no tty (script/pipe): don't hang on the picker
            fi
      fi

      if [[ "$profile" == work ]]; then
            _cc_work "$@"
      else
            _cc_personal "$@"
      fi
}

cc-bhr () {
      _cc_work "$@"
}

# Interactive profile picker: a highlighted list you drive with the
# arrow keys (or j/k), Enter to confirm, number keys as a shortcut, q/Esc to
# cancel. Draws the UI to the TTY and echoes the chosen profile on stdout, so
# the caller can capture it with $(...).
_cc_pick () {
      emulate -L zsh                                   # sets LOCAL_OPTIONS + LOCAL_TRAPS
      local tty=/dev/tty
      local -a labels=( "Personal" "Work  (bhr)" )
      local -a values=( personal work )
      local n=${#labels} sel=1 first=1 key i k2 k3

      trap 'print -n $'\''\e[?25h'\'' > /dev/tty' INT TERM   # never leave cursor hidden
      print -n $'\e[?25l' > $tty                            # hide cursor while drawing
      print -r -- $'\e[1mSelect Claude Code profile below:\e[0m' > $tty
      print -r -- $'\e[2m  ↑/↓ or 1-2  ·  enter to select  ·  q to cancel\e[0m' > $tty

      while true; do
            if (( first )); then first=0; else print -n $'\e['"$n"'A' > $tty; fi
            for (( i = 1; i <= n; i++ )); do
                  print -n $'\e[2K\r' > $tty              # clear the row before redraw
                  if (( i == sel )); then
                        print -r -- $'  \e[32m❯ '"${i}. ${labels[i]}"$'\e[0m' > $tty
                  else
                        print -r -- $'    \e[2m'"${i}. ${labels[i]}"$'\e[0m' > $tty
                  fi
            done

            IFS= read -rsk 1 key < $tty || { sel=0; break; }
            case "$key" in
                  $'\e')                                  # escape: maybe an arrow key
                        if IFS= read -rsk 1 -t 0.4 k2 < $tty && [[ $k2 == '[' || $k2 == 'O' ]]; then
                              IFS= read -rsk 1 -t 0.4 k3 < $tty
                              case "$k3" in
                                    A) (( sel = sel > 1 ? sel - 1 : n )) ;;   # up
                                    B) (( sel = sel < n ? sel + 1 : 1 )) ;;   # down
                              esac
                        else
                              sel=0; break                # bare Esc -> cancel
                        fi ;;
                  k|K) (( sel = sel > 1 ? sel - 1 : n )) ;;
                  j|J) (( sel = sel < n ? sel + 1 : 1 )) ;;
                  [1-9]) if (( key <= n )); then sel=$key; break; fi ;;
                  $'\n'|$'\r'|'') break ;;                 # Enter -> confirm current
                  q|Q|$'\x03') sel=0; break ;;             # q / Ctrl-C -> cancel
            esac
      done

      print -n $'\e[?25h' > $tty                         # restore cursor
      print -r -- '' > $tty
      (( sel == 0 )) && return 1
      print -r -- "${values[sel]}"
}

r9 () {
      local dir="$HOME/Projects/r9os"

      # First-run bootstrap: no checkout yet -> offer to clone from the home
      # forge. Auth comes from the Forgejo credential helper in .gitconfig.
      if [[ ! -d "$dir/.git" ]]; then
{{- if and (ne .forgejoDomain "") (ne .forgejoUser "") }}
            local base="https://{{ .forgejoDomain }}/{{ .forgejoUser }}"
            print "r9: no r9os checkout at $dir"
            if ! read -q "?r9: clone it from {{ .forgejoDomain }}? [y/N] "; then
                  print; return 1
            fi
            print
            git clone "$base/r9os.git" "$dir" || return 1
{{- if ne .r9osClassifiedRepo "" }}
            if read -q "?r9: also clone the classified tier ({{ .r9osClassifiedRepo }})? [y/N] "; then
                  print
                  git clone "$base/{{ .r9osClassifiedRepo }}.git" "$dir/brain/classified" ||
                        print -u2 "r9: classified clone failed; continuing without it"
            else
                  print
            fi
{{- end }}
{{- else }}
            print -u2 "r9: no r9os checkout at $dir, and no forge is configured"
            print -u2 "r9: set forgejoDomain/forgejoUser in chezmoi data, or clone manually"
            return 1
{{- end }}
      fi

      cd "$dir" || { print -u2 "r9: cannot cd to $dir"; return 1 }

      if [[ "$1" == -h || "$1" == --help ]]; then
            print "r9: cd to r9os and launch Claude Code."
            print "  r9               interactive profile picker (arrows / numbers)"
            print "  r9 --personal    personal profile"
            print "  r9 --work        work profile (bhr)"
            print "  extra args pass through to claude, e.g. r9 --personal --resume"
            return 0
      fi

      cc "$@"
}
# <<< Claude Code launchers <<<
