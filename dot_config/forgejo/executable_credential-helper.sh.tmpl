#!/bin/sh
# Git credential helper for the Forgejo forge ({{ .forgejoDomain }}).
#
# INTERIM design (until secrets move to Infisical). The PAT is read from a
# single on-disk file at the SAME path on every machine. This works headless —
# the rack Mac minis (M1mm, M2mm) are reached over SSH, where 1Password's
# op/Touch-ID cannot run (no console GUI, no Secure Enclave over SSH; Service
# Accounts need 1P Business, and this is a Family plan). It is also the exact
# mechanism Infisical will keep: Infisical renders the same file — only the
# *writer* changes (you via 1Password today -> Infisical later), not this helper.
#
# Resolution order on `get`:
#   1. $FORGEJO_TOKEN  — a raw token injected for a one-off / headless run.
#   2. ~/.config/forgejo/token (mode 600) — the canonical on-disk location.
#
# Provision:  op read op://Private/Forgejo/token > ~/.config/forgejo/token
#   (from a machine with 1Password), or push that file to a headless mini over
#   the SSH mesh. Rotate: regenerate the PAT, repaste into 1Password, rewrite
#   this file on each machine.

case "$1" in
  get)
    if [ -n "$FORGEJO_TOKEN" ]; then
      TOKEN="$FORGEJO_TOKEN"
    else
      TOKEN=$(cat "$HOME/.config/forgejo/token" 2>/dev/null)
    fi
    if [ -n "$TOKEN" ]; then
      echo "username={{ .forgejoUser }}"
      echo "password=$TOKEN"
    fi
    ;;
esac
