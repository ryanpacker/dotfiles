# >>> Claude Code launchers >>>
# cc      = personal profile (default ~/.claude config, permissions bypassed)
# cc-bhr  = work / BambooHR profile (isolated ~/.claude-bhr config + work token)
# r9      = cd to r9os, pick a profile, launch Claude Code there
cc () {
      claude --permission-mode bypassPermissions "$@"
}

cc-bhr () {
      CLAUDE_CONFIG_DIR="$HOME/.claude-bhr" command claude "$@"
}

r9 () {
      local dir="$HOME/Projects/r9os"
      cd "$dir" || { print -u2 "r9: cannot cd to $dir"; return 1 }

      local profile=""
      case "$1" in
            -p|--personal)     profile=personal; shift ;;
            -b|--bhr|--work)   profile=work; shift ;;
            -h|--help)
                  print "r9: cd to r9os and launch Claude Code."
                  print "  r9                    prompt for profile (single keypress)"
                  print "  r9 -p | --personal    personal profile (cc)"
                  print "  r9 -b | --bhr|--work  work profile (cc-bhr)"
                  print "  extra args pass through to claude, e.g. r9 -p --resume"
                  return 0 ;;
      esac

      if [[ -z "$profile" ]]; then
            print "Launch r9os with which profile?"
            print "  [1/p] personal  (cc)"
            print "  [2/b] work      (cc-bhr)"
            local key
            read -k 1 "key?> "
            print ""
            case "$key" in
                  1|p|P)          profile=personal ;;
                  2|b|B)          profile=work ;;
                  $'\n'|$'\r')    profile=personal ;;   # Enter = personal (default)
                  *)              print -u2 "r9: cancelled."; return 1 ;;
            esac
      fi

      if [[ "$profile" == work ]]; then
            cc-bhr "$@"
      else
            cc "$@"
      fi
}
# <<< Claude Code launchers <<<
